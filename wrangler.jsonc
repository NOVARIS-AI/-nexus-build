{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexus-build",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-18",
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexus-build-db",
      "database_id": "86e23706-7982-4921-82ef-8b88cc24d92a",
      "migrations_dir": "migrations"
    }
  ]
}
