{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "humanforge/web": [
        "./src/types/humanforge-web.d.ts"
      ],
      "humanforge/human": [
        "./src/types/humanforge-human.d.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
